NODE_ENV=production
HOST=127.0.0.1
PORT=3101
SIAP_DATA_DIR=/var/lib/siaptanjak
SIAP_MIGRATIONS_DIR=/opt/siaptanjak/current/drizzle
VINEXT_TRUST_PROXY=1
VINEXT_TRUSTED_HOSTS=tjsl.example.go.id
SIAP_SEED_EXAMPLE_DATA=0
# Opsional: isi dengan layanan relay email milik pengelola.
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
MAIL_FROM_EMAIL=
# Opsional: layanan pencarian NIB yang telah diotorisasi.
OSS_LOOKUP_URL=
OSS_API_TOKEN=
